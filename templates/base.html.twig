<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}QueueBreeze{% endblock %} · QueueBreeze</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><rect width=%22128%22 height=%22128%22 rx=%2228%22 fill=%22%230d9488%22/><text x=%2264%22 y=%2290%22 font-size=%2272%22 font-family=%22sans-serif%22 font-weight=%22bold%22 text-anchor=%22middle%22 fill=%22white%22>Q</text></svg>">
        {% block stylesheets %}{% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="{% block body_class %}patient-page{% endblock %} min-h-screen bg-slate-50">
        <header class="site-header no-print">
            <div class="site-header-inner">
                <a class="site-brand" href="{{ is_granted('ROLE_RECEPTIONIST') ? path('staff_dashboard') : path('home') }}">QueueBreeze</a>
                <nav class="staff-nav">
                    {% if is_granted('ROLE_RECEPTIONIST') %}
                        <a class="nav-link" href="{{ path('staff_dashboard') }}">Dashboard</a>
                        <a class="nav-link" href="{{ path('staff_check_in') }}">Check-in</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a class="nav-link" href="{{ path('admin_doctors') }}">Admin</a>
                        {% endif %}
                        <span class="muted-text px-2">{{ app.user.name }}</span>
                        <a class="nav-link" href="{{ path('staff_logout') }}" data-turbo="false">Log out</a>
                    {% else %}
                        <a class="nav-link" href="{{ path('join') }}">Get a token</a>
                        <a class="nav-link" href="{{ path('staff_login') }}">Staff login</a>
                    {% endif %}
                </nav>
            </div>
        </header>

        <main class="site-main">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ type }} no-print" role="status">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
